[{"name":"Wortmarke","text":"CircularFlow","formatting":{"font_size":32,"font_weight":"bold","color":"#17201D","line_height":1.2,"text_align":"start"}},{"name":"Kennzeichnung Ziel, noch keine Messung","text":"Ziel, noch keine Messung","formatting":{"font_size":26,"font_weight":"bold","color":"#594810","line_height":1.2,"text_align":"center"}},{"name":"Titel Zeile 1","text":"In einem Dortmunder Pilot wollen wir messen,","formatting":{"font_size":58,"font_weight":"bold","color":"#17201D","line_height":1.2,"text_align":"start"}},{"name":"Titel Zeile 2","text":"was wirklich wiederverwendet wird","formatting":{"font_size":58,"font_weight":"bold","color":"#0E5546","line_height":1.2,"text_align":"start"}},{"name":"Stufe angeboten","text":"angeboten","formatting":{"font_size":36,"font_weight":"bold","color":"#17201D","line_height":1.2,"text_align":"center"}},{"name":"Stufe rechtzeitig geprüft","text":"rechtzeitig geprüft","formatting":{"font_size":36,"font_weight":"bold","color":"#17201D","line_height":1.2,"text_align":"center"}},{"name":"Stufe wieder eingebaut","text":"wieder eingebaut","formatting":{"font_size":36,"font_weight":"bold","color":"#17201D","line_height":1.2,"text_align":"center"}},{"name":"Wenn nicht","text":"Wenn nicht: zu spät · Angaben fehlen · ungeeignet","formatting":{"font_size":34,"font_weight":"bold","color":"#A2261D","line_height":1.2,"text_align":"start"}},{"name":"Zitat","text":"„Es gibt kaum Daten\nzu Baustoffströmen.“","formatting":{"font_size":36,"font_weight":"bold","color":"#0E5546","line_height":1.25,"text_align":"start"}},{"name":"Zitatquelle","text":"Stadt Dortmund, Umweltamt,\nINNOSPRINT, 13.11.2026","formatting":{"font_size":26,"font_weight":"normal","color":"#3F4A45","line_height":1.3,"text_align":"start"}},{"name":"SDG","text":"SDG 12.5 · weniger Abfall durch Wiederverwendung (sinngemäß)","formatting":{"font_size":30,"font_weight":"bold","color":"#17201D","line_height":1.2,"text_align":"start"}},{"name":"Fußzeile","text":"SDG 12.5: Unte